rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin = the custom claim `admin: true` OR a document at admins/{uid} (create it in the Firebase console).
    function isAdmin() {
      return request.auth != null && (request.auth.token.admin == true
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    function mine() { return request.auth != null && request.auth.uid == resource.data.uid; }

    // A signed-in user may only check whether THEIR OWN admin document exists. Nobody can write it from the website.
    match /admins/{u}       { allow get: if request.auth != null && request.auth.uid == u; }

    // Balances, ledgers, attempts and cooldowns are written ONLY by the Node server (Admin SDK bypasses these rules).
    match /users/{u}        { allow read: if (request.auth != null && request.auth.uid == u) || isAdmin(); }
    match /tasks/{t}        { allow read: if mine() || isAdmin(); }
    match /ledger/{l}       { allow read: if mine() || isAdmin(); }
    match /withdrawals/{w}  { allow read: if mine() || isAdmin(); }
    match /postbacks/{p}    { allow read: if isAdmin(); }

    // --- SemaAfrica points ---
    match /opportunities/{o}    { allow read: if request.auth != null; allow write: if false; }   // edited via /api/adminUpdateOpportunity
    match /activityAttempts/{a} { allow read: if mine() || isAdmin(); }
    match /cooldowns/{c}        { allow read: if mine() || isAdmin(); }
    match /pointLedger/{l}      { allow read: if mine() || isAdmin(); }
    match /providerEvents/{e}   { allow read: if isAdmin(); }
    match /adminAudit/{a}       { allow read: if isAdmin(); }

    // --- legacy KES campaigns / partners (unchanged behaviour) ---
    match /campaigns/{c}       { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /campaignCosts/{c}   { allow read, write: if isAdmin(); }
    match /partners/{p}        { allow read, write: if isAdmin(); }
    match /partnerPayments/{p} { allow read, write: if isAdmin(); }
    match /tickets/{t} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid','subject','message','createdAt','reply']);
      allow read: if mine() || isAdmin();
      allow update: if isAdmin();
    }
  }
}
