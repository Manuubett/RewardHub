PORT=3000
SERVICE_ACCOUNT=./serviceAccountKey.json
# On a host (Render etc.) paste the whole key file contents here instead:
# SERVICE_ACCOUNT_JSON=
# your website origin(s), comma separated, no trailing slash
ALLOWED_ORIGINS=https://manuubett.github.io

# --- M-Pesa B2C (leave blank to keep manual "Mark paid" only) ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SECURITY_CREDENTIAL=
MPESA_SHORTCODE=
MPESA_INITIATOR_NAME=
# public https address of THIS server, no trailing slash (Safaricom calls it back)
PUBLIC_URL=
# long random string; generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CALLBACK_TOKEN=
